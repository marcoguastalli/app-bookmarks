# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bookmarks

# Host port the app is published on (container listens on 3000)
APP_PORT=3000

# Host directories for persistent data (bind mounts — survive `down -v` and
# even a Colima/Docker VM rebuild; back them up / include in Time Machine)
POSTGRES_DATA_DIR=~/opt/docker/bookmarks-data/postgres
PGADMIN_DATA_DIR=~/opt/docker/bookmarks-data/pgadmin

# pgAdmin Configuration (dev only — start with: docker compose --profile dev up)
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# API Configuration
NODE_ENV=production
PORT=3000
MAX_FOLDER_DEPTH=10
LOG_LEVEL=info

# DATABASE_URL is not needed for Docker Compose — it is built automatically
# from the POSTGRES_* vars above and points the API at the "postgres" service.
# Only set this when running the API locally, outside Docker (use api/.env.example):
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Shared Postgres (optional) — only used with:
#   docker compose -f docker-compose.yml -f docker-compose.shared-db.yml up api --no-deps
# Points the api at the shared instance in my_docker/postgres/src/v1 instead
# of this repo's own postgres service. See README "Shared Postgres mode".
#SHARED_POSTGRES_HOST=postgres-shared
#SHARED_POSTGRES_DB=bookmarks
#SHARED_POSTGRES_USER=postgres
#SHARED_POSTGRES_PASSWORD=admin123four
