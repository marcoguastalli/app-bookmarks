# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bookmarks

# pgAdmin Configuration (dev only)
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# API Configuration
NODE_ENV=production
PORT=3000
MAX_FOLDER_DEPTH=10
LOG_LEVEL=info

# DATABASE_URL is not needed for Docker Compose — it is built automatically
# from the POSTGRES_* vars above and points the API at the "postgres" service.
# Only set this when running the API locally, outside Docker (use api/.env.example):
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
